{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "regions": [
        "hnd1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/backups/run-scheduled",
      "schedule": "0 16 * * *"
    }
  ]
}
